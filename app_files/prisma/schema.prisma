generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EXECUTIVE_ADMIN
  AREA_HEAD
  COUNSELOR
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  UNSPECIFIED
}

enum Unit {
  UNIT1
  UNIT2
  UNIT3
  UNIT4
}

enum SwimLevel {
  BLUEGILL
  WALLEYE
  MUSKIE
  PENDING_SWIM_TEST
}

enum Period {
  P1A
  P2A
  P3A
  P4A
  P5A
  P1B
  P2B
  P3B
  P4B
  P5B
}

enum LimitType {
  FIXED
  FLEXIBLE
  UNLIMITED
  SPECIAL_APPROVAL
}

enum RegistrationStatus {
  ACTIVE
  WAITLISTED
  REMOVED
  OVERRIDDEN
}

enum RegistrationRole {
  CAMPER
  TEACHING_ASSISTANT
}

enum RegistrationWindow {
  Q1
  Q2
  Q3
}

enum AttendanceMark {
  PRESENT
  ABSENT
  EXCUSED
  NOT_EXPECTED
  LATE
}

enum CamperStatus {
  ACTIVE
  LEFT_SESSION_EARLY
  ON_TRIP
  HEALTH_CENTER
  EXCUSED
  SWITCHED_OUT
  NOT_ENROLLED_THIS_DATE
}

enum WeekBlock {
  WK1_2
  WK3_4
  WK5_6
  WK7
}

enum SwitchType {
  CAMPER
  STAFF
}

enum SwitchStatus {
  PENDING
  APPROVED
  DENIED
  OVERRIDDEN
}

enum SessionDayType {
  A
  B
  S
  ARRIVAL
  REGISTRATION
  DEPARTURE
  SPECIAL
  NO_CLASSES
}

enum RosterChangeDirection {
  ADDED
  REMOVED
}

// LEGACY (outages redesign, July 2026): subjectType/camperId/staffId/cabinId
// on Outage are no longer written by the create form -- every new outage
// links campers/staff via OutageCamper/OutageStaff join tables instead, so
// a trip roster is an explicit snapshot (not a live cabin link) and can mix
// campers from any cabin plus any number of staff. These legacy fields stay
// on the model only so existing rows keep their data until the one-time
// "Migrate legacy records" action (Outages page) has backfilled every row
// into the join tables -- at which point a follow-up commit drops them.
enum OutageSubjectType {
  CAMPER
  STAFF
  CABIN
  MANUAL_TRIP
}

enum OutageReason {
  TRIP
  INFIRMARY
  SICK
  OFF_CAMP
  VACATION_AWAY
  CUSTOM
}

enum OutageStatus {
  ACTIVE
  RESOLVED
}

// Bunk Management: the staff-to-cabin assignment tag ("Unit Head",
// "Unit Programmer", or plain counselor) is deliberately NOT a field here.
// Per direct instruction, that label must always be pulled live from the
// same Staff.position/position2 fields already maintained on the Staff
// Management screen -- see lib/bunk-staff-tags.ts deriveCabinRoleLabel().
// Storing it here would let it drift out of sync the moment someone's
// position changes without their cabin assignment being touched.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(COUNSELOR)
  active       Boolean  @default(true)
  areaId       String?
  area         Area?    @relation(fields: [areaId], references: [id])
  // Read-only Bunk Management access for the Girls Side Head / Boys Side
  // Head accounts — a permission axis independent of role/areaId, since
  // Area means an activity department (Waterfront, Sports, etc.), not a
  // camp side. null = no Bunk Management access; MALE = full boys-side
  // read access; FEMALE = full girls-side read access. Never grants write
  // access — that stays EXECUTIVE_ADMIN-only regardless of this field.
  bunkManagementView Gender?

  approvedRegistrations Registration[]     @relation("RegistrationApprover")
  staffAssignments      StaffAssignment[]  @relation("StaffAssignmentCreator")
  attendanceRecords     AttendanceRecord[] @relation("AttendanceTaker")
  decidedSwitches       SwitchRequest[]    @relation("SwitchDecider")
  createdOutages        Outage[]           @relation("OutageCreator")
  auditEvents           AuditLog[]         @relation("AuditLogActor")
  resolvedPreScreamConflicts PreScreamConflict[] @relation("PreScreamConflictResolver")
  preScreamClaims            PreScreamClaim[]    @relation("PreScreamClaimant")
  resolvedRosterReprintFlags RosterReprintFlag[] @relation("RosterReprintResolver")
  createdCabinStaffAssignments CabinStaffAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Append-only security audit log. Recorded for sensitive events:
/// login success/fail, logout, user role/active changes, user create.
/// Other operations (registrations, schedule edits) are intentionally
/// NOT logged here yet — keeps overhead minimal and the table small.
/// Read-only from the app side; truncate/archive in DB tooling if it
/// ever grows too large.
model AuditLog {
  id         String   @id @default(cuid())
  ts         DateTime @default(now())
  // The actor (user who performed the action). Null for failed-login
  // attempts where we don't know who was actually trying.
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Free-form short string like "login.success", "login.fail",
  // "user.role_change", "user.create", "user.toggle_active", "logout".
  action     String
  // Optional target descriptor — usually a userId for user.*
  // actions. Free-form so we can extend without schema changes.
  targetType String?
  targetId   String?
  // Network identity at time of action.
  ip         String?
  userAgent  String?
  // Arbitrary structured detail (e.g., { fromRole, toRole, email }).
  metadata   Json?

  @@index([ts])
  @@index([action, ts])
  @@index([actorId, ts])
}

model Session {
  id       String    @id @default(cuid())
  name     String
  year     Int
  cycle    String
  startsAt DateTime?
  endsAt   DateTime?
  active              Boolean   @default(false)
  screamSessionLocked Boolean   @default(false)
  preScreamOpen       Boolean   @default(false)
  notes    String?
  color    String    @default("forest")
  // Bumped whenever staff assignments are auto-released (see
  // releaseStaffAssignmentsForOffering) — deleting StaffAssignment rows
  // doesn't touch any remaining row's updatedAt, so this gives the Scream
  // Session freshness check something to detect for that case.
  lastStaffingChangeAt DateTime?
  // Whichever staff member is currently pulled up on the live Scream
  // Session board (the person actively being staffed). No FK relation —
  // deliberately just an ID reference, since this is transient UI state
  // for highlighting the matching row on the Staff Schedule live view, not
  // core data; if that Staff record is ever deleted, this simply stops
  // matching anything, which is harmless.
  currentScreamStaffId String?

  menus                         Menu[]
  campers                       Camper[]
  staffAssignments              StaffAssignment[]
  staffOffPeriods               StaffOffPeriod[]
  preScreamConflicts            PreScreamConflict[]
  rosterReprintFlags            RosterReprintFlag[]
  registrations                 Registration[]
  attendanceRecords             AttendanceRecord[]
  switchRequests                SwitchRequest[]
  calendarDays                  SessionCalendarDay[]
  outages                       Outage[]
  camperWeekEnrollments         CamperWeekEnrollment[]
  camperFilterGroups            CamperFilterGroup[]
  registrationAssignmentReports RegistrationAssignmentReport[]
  cabinStaffAssignments         CabinStaffAssignment[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activityOfferings ActivityOffering[]
}

model Menu {
  id        String  @id @default(cuid())
  sessionId String
  name      String
  cycle     String
  active    Boolean @default(true)
  notes     String?

  session       Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offerings     ActivityOffering[]
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cabin {
  id              String                 @id @default(cuid())
  name            String                 @unique
  unit            Unit
  gender          Gender
  beds            Int                    @default(0)
  campers         Camper[]
  staff           Staff[]
  weekEnrollments CamperWeekEnrollment[]
  outages         Outage[]
  cabinStaffAssignments CabinStaffAssignment[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model Camper {
  id                 String       @id @default(cuid())
  firstName          String
  lastName           String
  nickname           String?
  gender             Gender
  genderIdentity     String?
  age                Float?
  campGrade          String?
  unit               Unit
  cabinId            String?
  swimLevel          SwimLevel
  medicalFlags       String?
  counselorAssistant Boolean      @default(false)
  active             Boolean      @default(true)
  status             CamperStatus @default(ACTIVE)
  sessionId          String?
  externalId         String?

  cabin               Cabin?                     @relation(fields: [cabinId], references: [id])
  session             Session?                   @relation(fields: [sessionId], references: [id])
  registrations       Registration[]
  attendanceRecords   AttendanceRecord[]
  switchRequests      SwitchRequest[]            @relation("CamperSwitches")
  weekEnrollments     CamperWeekEnrollment[]
  sessionDesignations CamperSessionDesignation[]
  allergies           CamperAllergy[]
  outages             Outage[] // LEGACY -- see Outage.subjectType comment
  outageLinks         OutageCamper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([firstName, lastName, sessionId, cabinId])
  @@index([counselorAssistant])
}

model CamperSessionDesignation {
  id       String  @id @default(cuid())
  camperId String
  label    String
  source   String?

  camper Camper @relation(fields: [camperId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([camperId, label])
  @@index([label])
}

model CamperWeekEnrollment {
  id        String    @id @default(cuid())
  camperId  String
  sessionId String
  weekBlock WeekBlock
  cabinId   String?
  cabinName String?

  camper  Camper  @relation(fields: [camperId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cabin   Cabin?  @relation(fields: [cabinId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([camperId, sessionId, weekBlock])
  @@index([sessionId, weekBlock, cabinId])
}

model CamperFilterGroup {
  id                  String  @id @default(cuid())
  sessionId           String
  name                String
  description         String?
  weekBlocks          String?
  sessionDesignations String?
  active              Boolean @default(true)
  createdByUserId     String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, name])
  @@index([sessionId, active])
}

model AllergyLabel {
  id       String          @id @default(cuid())
  name     String          @unique
  category String?
  active   Boolean         @default(true)
  campers  CamperAllergy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CamperAllergy {
  id             String  @id @default(cuid())
  camperId       String
  allergyLabelId String
  notes          String?

  camper       Camper       @relation(fields: [camperId], references: [id], onDelete: Cascade)
  allergyLabel AllergyLabel @relation(fields: [allergyLabelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([camperId, allergyLabelId])
  @@index([allergyLabelId])
}

model Staff {
  id                  String    @id @default(cuid())
  firstName           String
  lastName            String
  age                 Float?
  position            String?
  position2           String?
  employmentStart     DateTime?
  employmentEnd       DateTime?
  screamEligible      Boolean   @default(true)
  statusCertification String?
  availabilityNotes   String?
  sessionAvailability String?
  swimLevel           SwimLevel?
  active              Boolean   @default(true)
  cabinId             String?
  housingLabel        String?
  // Structured housing (Location + optional Room within it). housingLabel
  // above is kept in sync as a derived display string whenever these are
  // set from the Staff Housing page, so every screen that only reads
  // housingLabel (search, scream session, reports, imports) keeps working
  // unchanged. onDelete: SetNull is a defense-in-depth backstop -- the
  // delete actions for HousingLocation/HousingRoom already require the
  // location/room to be empty before allowing a delete at all.
  housingLocationId   String?
  housingRoomId       String?
  // Alternate name a staff member is known by on rosters/cabin sheets
  // (nickname or a spelling variant) — not their canonical name, just an
  // extra alias so future imports recognize "Isabella" as "Bella" without
  // needing to re-confirm the same match every time.
  nickname            String?
  primaryAreaId       String?

  cabin                      Cabin?                      @relation(fields: [cabinId], references: [id])
  housingLocation             HousingLocation?           @relation(fields: [housingLocationId], references: [id], onDelete: SetNull)
  housingRoom                 HousingRoom?                @relation(fields: [housingRoomId], references: [id], onDelete: SetNull)
  primaryArea                Area?                       @relation("PrimaryStaffArea", fields: [primaryAreaId], references: [id])
  secondaryAreas             Area[]                      @relation("StaffSecondaryAreas")
  skills                     Skill[]
  certifications             Certification[]
  assignments                StaffAssignment[]
  offPeriods                 StaffOffPeriod[]
  switchRequests             SwitchRequest[]             @relation("StaffSwitches")
  outages                    Outage[] // LEGACY -- see Outage.subjectType comment
  outageLinks                OutageStaff[]
  registrationAssignmentRows RegistrationAssignmentRow[]
  preScreamConflicts         PreScreamConflict[]
  cabinStaffAssignments      CabinStaffAssignment[]
  unitPreferences            StaffUnitPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([active, screamEligible])
  @@index([housingLocationId])
  @@index([housingRoomId])
}

// Non-cabin staff housing (Nurse Cabin, Staff House, etc). Optional rooms
// let a location like Staff House be broken into ~13 individually-staffed
// rooms with their own bed counts, while simple locations (Off Camp,
// Karen's Condo) stay flat with staff assigned directly to the location.
// See STAFF_HOUSING_SPEC.md.
model HousingLocation {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  rooms     HousingRoom[]
  staff     Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HousingRoom {
  id         String          @id @default(cuid())
  locationId String
  name       String
  bedCount   Int?
  sortOrder  Int             @default(0)
  location   HousingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff      Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, name])
  @@index([locationId])
}

// Bunk Management: session-scoped staff-to-cabin assignment. This is
// deliberately NOT the same thing as Staff.cabinId -- Staff rows persist
// across the whole summer (no sessionId field), so a single scalar cabinId
// can't hold a different Q1 vs Q2 vs Q3 assignment at the same time without
// silently losing history the moment the next quarter's import runs. The
// @@unique([staffId, sessionId]) below is what makes "never double-booked"
// a real database guarantee rather than just a UI convention -- an attempt
// to assign someone already assigned elsewhere this session is rejected at
// the DB level, not just discouraged by the drag-and-drop UI.
//
// CAs are never represented here -- see Camper.counselorAssistant. Creating
// a CabinStaffAssignment (or any Staff row) for a CA would reintroduce the
// exact bug the Q1->Q2 cabin import fix corrected (see lib/ca-staff-exclusion.ts).
model CabinStaffAssignment {
  id              String         @id @default(cuid())
  staffId         String
  cabinId         String
  sessionId       String
  createdByUserId String?

  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cabin     Cabin    @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, sessionId])
  @@index([cabinId, sessionId])
}

// Bunk Management: a staff member's ranked unit preference, transcribed by
// an admin from the paper survey -- not a staff-facing self-service form.
// rank 1 = first choice. Never populated for CAs (see Camper.counselorAssistant)
// since preference ranking is a Staff-only concept.
model StaffUnitPreference {
  id      String @id @default(cuid())
  staffId String
  unit    Unit
  rank    Int

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, unit])
  @@index([staffId, rank])
}

model Area {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  active      Boolean @default(true)

  users          User[]
  activities     Activity[]
  offerings      ActivityOffering[]
  primaryStaff   Staff[]            @relation("PrimaryStaffArea")
  secondaryStaff Staff[]            @relation("StaffSecondaryAreas")
  preScreamClaims PreScreamClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id           String  @id @default(cuid())
  areaId       String
  name         String
  slug         String
  abbreviation String?
  active       Boolean @default(true)
  description  String?

  area                   Area               @relation(fields: [areaId], references: [id], onDelete: Cascade)
  offerings              ActivityOffering[]
  requiredSkills         Skill[]            @relation("ActivityRequiredSkills")
  requiredCertifications Certification[]    @relation("ActivityRequiredCertifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, slug])
}

model ActivityOffering {
  id                           String    @id @default(cuid())
  sessionId                    String
  menuId                       String
  areaId                       String
  activityId                   String
  period                       Period
  eligibleUnits                String
  eligibleSwimLevels           String
  rosterLimit                  Int?
  limitType                    LimitType @default(SPECIAL_APPROVAL)
  allowOverride                Boolean   @default(true)
  allowWaitlist                Boolean   @default(false)
  preAssigned                  Boolean   @default(false)
  spansTwoPeriods              Boolean   @default(false)
  staffTarget                  Int       @default(2)
  active                       Boolean   @default(true)
  visibleOnMenu                Boolean   @default(true)
  visibleForCamperRegistration Boolean   @default(true)
  visibleOnMasterMenu          Boolean   @default(true)
  includeInPrint               Boolean   @default(true)
  notes                        String?

  session           Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menu              Menu               @relation(fields: [menuId], references: [id], onDelete: Cascade)
  area              Area               @relation(fields: [areaId], references: [id], onDelete: Cascade)
  activity          Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registrations     Registration[]
  staffAssignments  StaffAssignment[]
  attendanceRecords AttendanceRecord[]
  currentSwitches   SwitchRequest[]    @relation("CurrentOffering")
  requestedSwitches SwitchRequest[]    @relation("RequestedOffering")
  menuRows          MenuDisplayRow[]
  preScreamClaims   PreScreamClaim[]
  rosterReprintFlags RosterReprintFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuId, activityId, period, notes])
  @@index([sessionId, menuId, period])
}

model MenuDisplayRow {
  id             String  @id @default(cuid())
  offeringId     String
  label          String
  visible        Boolean @default(true)
  includeInPrint Boolean @default(true)
  sortOrder      Int     @default(0)

  offering ActivityOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offeringId])
}

model Registration {
  id                 String             @id @default(cuid())
  camperId           String
  offeringId         String
  sessionId          String
  menuId             String
  period             Period
  registrationWindow RegistrationWindow @default(Q1)
  registrationRole   RegistrationRole   @default(CAMPER)
  counselorApproval  String?
  approvedByUserId   String?
  status             RegistrationStatus @default(ACTIVE)
  overrideReason     String?
  // Only set when status is WAITLISTED — preserves join order so the
  // waitlist can be displayed/worked in the order people signed up.
  waitlistPosition   Int?

  camper     Camper             @relation(fields: [camperId], references: [id], onDelete: Cascade)
  offering   ActivityOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  session    Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menu       Menu               @relation(fields: [menuId], references: [id], onDelete: Cascade)
  approvedBy User?              @relation("RegistrationApprover", fields: [approvedByUserId], references: [id])
  attendance AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([camperId, sessionId, registrationWindow, period, status])
  @@index([offeringId, registrationWindow, status])
  @@index([offeringId, registrationWindow, registrationRole, status])
  @@index([offeringId, status, waitlistPosition])
}

model StaffAssignment {
  id              String  @id @default(cuid())
  staffId         String
  offeringId      String
  sessionId       String
  period          Period
  role            String?
  notes           String?
  createdByUserId String?

  staff     Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  offering  ActivityOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("StaffAssignmentCreator", fields: [createdByUserId], references: [id])
  switches  SwitchRequest[]  @relation("StaffAssignmentSwitches")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, sessionId, period])
  @@index([offeringId])
}

model StaffOffPeriod {
  id              String  @id @default(cuid())
  staffId         String
  sessionId       String
  period          Period
  createdByUserId String?

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, sessionId, period])
  @@index([sessionId, period])
}

/// Holds a contested (staffId, period) slot when 2+ areas want the same
/// person for the same period during PreScream. The "first" claim on a
/// slot never creates a row here at all — it just becomes a normal
/// StaffAssignment, exactly like assigning someone on the live Scream
/// Session board always has. A conflict only exists for the SECOND (or
/// third...) area contending for someone who's already assigned — see
/// preScreamAssign in admin/prescream/actions.ts. Resolving in either
/// direction (via the PreScream conflicts screen, or by simply
/// reassigning that person directly on the live board) sets resolvedAt —
/// the live board is always authoritative and can override this at any
/// time without going through PreScream at all.
model PreScreamConflict {
  id               String    @id @default(cuid())
  sessionId        String
  staffId          String
  period           Period
  resolvedAt       DateTime?
  resolvedByUserId String?

  session    Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff      Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  resolvedBy User?            @relation("PreScreamConflictResolver", fields: [resolvedByUserId], references: [id])
  claims     PreScreamClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, staffId, period])
  @@index([sessionId, resolvedAt])
}

/// One area's contending request within an open PreScreamConflict. The
/// area that currently holds the real StaffAssignment is NOT a
/// PreScreamClaim row — it's implicit (look up StaffAssignment for the
/// same staffId+sessionId+period). This table only holds the "runner-up"
/// claims that couldn't get the slot when they asked.
model PreScreamClaim {
  id              String  @id @default(cuid())
  conflictId      String
  offeringId      String
  areaId          String
  claimedByUserId String?

  conflict  PreScreamConflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  offering  ActivityOffering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  area      Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
  claimedBy User?             @relation("PreScreamClaimant", fields: [claimedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([conflictId, offeringId])
}

/// Flags an offering's printed roster as stale — created automatically
/// when an approved camper switch changes that offering's roster (see
/// decideSwitch in app/switches/actions.ts). Two flags are created per
/// switch: one for the offering the camper left, one for the offering
/// they joined, so both the losing and gaining area head see it. Cleared
/// explicitly (there's no way to detect an actual browser print, so
/// clearing is a deliberate "I reprinted this" action) rather than
/// automatically.
model RosterReprintFlag {
  id               String    @id @default(cuid())
  sessionId        String
  offeringId       String
  reason           String
  resolvedAt       DateTime?
  resolvedByUserId String?

  // Denormalized (plain strings, no FK) so the flag still reads correctly
  // even if the camper record or the acting users are later changed/
  // removed. Nullable so existing rows created before this addition don't
  // need a backfill.
  camperId      String?
  camperName    String?
  direction     RosterChangeDirection?
  requestedBy   String?
  decidedByName String?

  session    Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offering   ActivityOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  resolvedBy User?            @relation("RosterReprintResolver", fields: [resolvedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId, offeringId, resolvedAt])
}

model AttendanceRecord {
  id             String         @id @default(cuid())
  registrationId String?
  camperId       String
  offeringId     String
  sessionId      String
  date           DateTime
  mark           AttendanceMark
  camperStatus   CamperStatus   @default(ACTIVE)
  note           String?
  takenByUserId  String?

  registration Registration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  camper       Camper           @relation(fields: [camperId], references: [id], onDelete: Cascade)
  offering     ActivityOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  session      Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  takenBy      User?            @relation("AttendanceTaker", fields: [takenByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([camperId, offeringId, date])
  @@index([date, mark])
}

model SwitchRequest {
  id                  String       @id @default(cuid())
  type                SwitchType
  status              SwitchStatus @default(PENDING)
  sessionId           String
  camperId            String?
  staffId             String?
  currentOfferingId   String?
  requestedOfferingId String?
  staffAssignmentId   String?
  period              Period
  reason              String?
  validationNotes     String?
  requestedBy         String?
  decidedByUserId     String?
  decidedAt           DateTime?

  session           Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  camper            Camper?           @relation("CamperSwitches", fields: [camperId], references: [id], onDelete: Cascade)
  staff             Staff?            @relation("StaffSwitches", fields: [staffId], references: [id], onDelete: Cascade)
  currentOffering   ActivityOffering? @relation("CurrentOffering", fields: [currentOfferingId], references: [id], onDelete: SetNull)
  requestedOffering ActivityOffering? @relation("RequestedOffering", fields: [requestedOfferingId], references: [id], onDelete: SetNull)
  staffAssignment   StaffAssignment?  @relation("StaffAssignmentSwitches", fields: [staffAssignmentId], references: [id], onDelete: SetNull)
  decidedBy         User?             @relation("SwitchDecider", fields: [decidedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SessionCalendarDay {
  id        String         @id @default(cuid())
  sessionId String
  date      DateTime
  dayType   SessionDayType
  notes     String?
  events    String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, date])
  @@index([date, dayType])
}

model Outage {
  id          String       @id @default(cuid())
  sessionId   String
  reason      OutageReason
  status      OutageStatus @default(ACTIVE)
  manualTitle String?
  // Free-text trip location (e.g. "Town — ice cream trip", "Infirmary").
  // Optional; shown on the trip card and in printable reports when set.
  location    String?
  startDate   DateTime
  endDate     DateTime
  fullDay     Boolean      @default(true)
  periods     String?
  notes       String?
  resolvedAt  DateTime?

  // LEGACY -- see comment on OutageSubjectType above. Never set by new
  // outages; only present on rows created before the July 2026 redesign,
  // until "Migrate legacy records" backfills them into the join tables
  // below and a follow-up commit drops these columns entirely.
  subjectType OutageSubjectType?
  camperId    String?
  staffId     String?
  cabinId     String?
  camper      Camper?            @relation(fields: [camperId], references: [id], onDelete: Cascade)
  staff       Staff?             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cabin       Cabin?             @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  createdByUserId String?

  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("OutageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campers    OutageCamper[]
  staffLinks OutageStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, status, startDate, endDate])
  @@index([camperId])
  @@index([staffId])
  @@index([cabinId])
}

// Explicit snapshot link between a trip/outage and a camper who went on it.
// Deliberately a fixed roster captured at creation time, not a live query
// against current cabin membership -- so the record of who actually went
// stays accurate even if cabin assignments change later.
model OutageCamper {
  id       String @id @default(cuid())
  outageId String
  camperId String

  outage Outage @relation(fields: [outageId], references: [id], onDelete: Cascade)
  camper Camper @relation(fields: [camperId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([outageId, camperId])
  @@index([camperId])
}

// Explicit link between a trip/outage and a staff member who went on/is
// covering it, with an optional per-person contact phone for that trip
// (e.g. the cell phone they're carrying that day) -- not their profile.
model OutageStaff {
  id       String  @id @default(cuid())
  outageId String
  staffId  String
  phone    String?

  outage Outage @relation(fields: [outageId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([outageId, staffId])
  @@index([staffId])
}

model Certification {
  id         String     @id @default(cuid())
  name       String     @unique
  active     Boolean    @default(true)
  staff      Staff[]
  activities Activity[] @relation("ActivityRequiredCertifications")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Skill {
  id         String     @id @default(cuid())
  name       String     @unique
  active     Boolean    @default(true)
  staff      Staff[]
  activities Activity[] @relation("ActivityRequiredSkills")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model RegistrationAssignmentReport {
  id                String    @id @default(cuid())
  sessionId         String?
  registrationLabel String
  registrationDate  DateTime?
  notes             String?

  session Session?                    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  rows    RegistrationAssignmentRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, updatedAt])
}

model RegistrationAssignmentRow {
  id              String  @id @default(cuid())
  reportId        String
  section         String
  label           String
  staffId         String?
  customStaffName String?
  sortOrder       Int
  isCustom        Boolean @default(false)
  hidden          Boolean @default(false)

  report RegistrationAssignmentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  staff  Staff?                       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId, section, sortOrder])
  @@index([staffId])
}
